{
  "expo": {
    "name": "Parlay Pal",
    "slug": "parlayPal",
    "version": "2.4.7",
    "orientation": "portrait",
    "icon": "./assets/parlaypalIcon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/blackSplash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.markjvoltaire.parlayPal",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSPhotoLibraryUsageDescription": "Parlay Pal needs access to your photo library to allow you to upload images, enabling analysis enhance your bet slip.",
        "PrivacyPolicyUrl": "https://parlaypalterms.onrender.com"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.markjvoltaire.parlayPal",
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fa942835-78e5-4c35-a7f9-d97d9ee78c66"
      }
    }
  }
}
